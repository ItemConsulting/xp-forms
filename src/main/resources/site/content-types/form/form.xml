<?xml version="1.0" encoding="UTF-8"?>
<content-type xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="contentType.form.displayName">Form</display-name>
  <description i18n="contentType.form.description">Tool to build</description>
  <super-type>base:structured</super-type>

  <form>
    <field-set>
      <label i18n="contentType.form.submission">Submission</label>
      <items>
        <input name="integrationId" type="CustomSelector">
          <label i18n="contentType.form.integrationId">Form type</label>
          <occurrences minimum="0" maximum="1"/>
          <config>
            <service>form-integrations</service>
          </config>
        </input>
      </items>
    </field-set>

    <item-set name="pages">
      <label i18n="contentType.form.page">Page</label>
      <occurrences minimum="1" maximum="0"/>

      <items>
        <input name="title" type="TextLine">
          <label i18n="contentType.form.title">Title</label>
          <occurrences minimum="1" maximum="1"/>
        </input>

        <input name="text" type="HtmlArea">
          <label i18n="contentType.form.pageDescription">Page description</label>
          <occurrences minimum="0" maximum="1"/>
        </input>

        <mixin name="fields"/>

        <input name="submitButtonText" type="TextLine">
          <label i18n="contentType.form.submitButtonText">Submit button text</label>
          <occurrences minimum="1" maximum="1"/>
          <default>Neste</default>
        </input>
      </items>
    </item-set>

    <option-set name="reviewPage">
      <label i18n="contentType.form.reviewPage">Review page</label>
      <occurrences minimum="1" maximum="1"/>

      <options minimum="0" maximum="1">
        <option name="showReviewPage">
          <label i18n="contentType.form.showReviewPage">Show review page</label>
          <items>
            <input name="title" type="TextLine">
              <label i18n="contentType.form.showReviewPage.title">Review page title</label>
              <occurrences minimum="1" maximum="1"/>
              <default>Vurder svarene dine og send inn</default>
            </input>

            <input name="submitButtonText" type="TextLine">
              <label i18n="contentType.form.submitButtonText">Submit button text</label>
              <occurrences minimum="1" maximum="1"/>
              <default>Aksepter og send inn</default>
            </input>
          </items>
        </option>
      </options>
    </option-set>

    <item-set name="successPageSections">
      <label i18n="contentType.form.successPageSections">Success page</label>
      <occurrences minimum="1" maximum="1"/>

      <items>
        <input name="text" type="HtmlArea">
          <label i18n="contentType.form.successPageSections.text">Text</label>
          <default>Tusen takk. Ditt svar har blitt registrert.</default>
          <occurrences minimum="0" maximum="1"/>
        </input>
      </items>
    </item-set>
  </form>
</content-type>
