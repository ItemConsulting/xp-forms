<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="mixin.fieldPropsCommon.displayName">Common properties</display-name>
  <description i18n="mixin.fieldPropsCommon.description">Common properties for form fields</description>

  <form>
    <input name="label" type="TextLine">
      <label i18n="mixin.fieldPropsCommon.label">Label</label>
      <occurrences minimum="1" maximum="1"/>
    </input>

    <input name="name" type="TextLine">
      <label i18n="mixin.fieldPropsCommon.name">name</label>
      <help-text i18n="mixin.fieldPropsCommon.nameHelpText">Programmatic name for the field</help-text>
      <occurrences minimum="0" maximum="1"/>
      <config>
        <regexp>^\S+$</regexp>
      </config>
    </input>

    <input name="helpText" type="HtmlArea">
      <label i18n="mixin.fieldPropsCommon.helpText">Help text</label>
      <help-text i18n="mixin.fieldPropsCommon.helpTextHelpText">Text displayed beneath the "field name"</help-text>
      <occurrences minimum="0" maximum="1"/>
    </input>

    <input name="value" type="TextLine">
      <label i18n="mixin.fieldPropsCommon.value">Initialize field with this value</label>
      <occurrences minimum="0" maximum="1"/>
    </input>
  </form>
</mixin>
