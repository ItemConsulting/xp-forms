<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="mixin.fieldPropsSelect.displayName">Common selection fields</display-name>
  <description i18n="mixin.fieldPropsSelect.description">Fields that are common for select and input[type=radio]</description>

  <form>
    <option-set name="properties">
      <label i18n="mixin.fieldPropsSelect.properties">Properties</label>
      <occurrences minimum="1" maximum="1"/>

      <options minimum="0" maximum="0">
        <option name="validationRequired">
          <label i18n="mixin.fieldPropsSelect.required">Validation: Required</label>
          <help-text i18n="mixin.fieldPropsSelect.requiredHelpText">This field must always have a value</help-text>
          <items>
            <input name="errorMessage" type="TextLine">
              <label i18n="mixin.fieldPropsSelect.errorMessage">Error message</label>
              <occurrences minimum="0" maximum="1"/>
            </input>
          </items>
        </option>
      </options>
    </option-set>
  </form>
</mixin>
