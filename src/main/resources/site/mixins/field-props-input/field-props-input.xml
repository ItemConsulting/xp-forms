<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<mixin xmlns="urn:enonic:xp:model:1.0">
  <!-- See https://json-schema.org/draft/2020-12/json-schema-validation.html -->
  <display-name i18n="mixin.fieldPropsInput.displayName">Properties</display-name>
  <description i18n="mixin.fieldPropsInput.description">Different properties an input field can have</description>

  <form>
    <option-set name="properties">
      <label i18n="mixin.fieldPropsInput.properties">Properties</label>
      <occurrences minimum="1" maximum="1"/>

      <options minimum="0" maximum="0">
        <option name="placeholder">
          <label i18n="mixin.fieldPropsInput.placeholder">Placeholder</label>
          <help-text i18n="mixin.fieldPropsInput.placeholderHelpText">Placeholder text in input field</help-text>
          <items>
            <input name="placeholder" type="TextLine">
              <label i18n="mixin.fieldPropsInput.placeholderText">Placeholder text</label>
              <help-text i18n="mixin.fieldPropsInput.placeholderHelpText">Placeholder text in input field</help-text>
              <occurrences minimum="1" maximum="1"/>
            </input>
          </items>
        </option>

        <option name="inputMode">
          <label i18n="mixin.fieldPropsInput.inputMode">Keyboard on mobile</label>
          <help-text i18n="mixin.fieldPropsInput.inputModeHelpText">Chose keyboard to use</help-text>
          <items>
            <input name="inputmode" type="RadioButton">
              <label i18n="mixin.fieldPropsInput.inputMode">Keyboard on mobile</label>
              <help-text i18n="mixin.fieldPropsInput.inputModeHelpText">Select keyboard to show on mobile</help-text>
              <occurrences minimum="0" maximum="1"/>
              <config>
                <option value="text" i18n="mixin.fieldPropsInput.inputModeText">Text</option>
                <option value="decimal" i18n="mixin.fieldPropsInput.inputModeDecimal">Decimal</option>
                <option value="numeric" i18n="mixin.fieldPropsInput.inputModeNumeric">Numeric</option>
                <option value="tel" i18n="mixin.fieldPropsInput.inputModeTel">Tel</option>
                <option value="search" i18n="mixin.fieldPropsInput.inputModeSearch">Search</option>
                <option value="email" i18n="mixin.fieldPropsInput.inputModeEmail">Email</option>
                <option value="url" i18n="mixin.fieldPropsInput.inputModeUrl">Url</option>
              </config>
              <default>text</default>
            </input>
          </items>
        </option>

        <option name="autocomplete">
          <label i18n="mixin.fieldPropsInput.autocomplete">Autocomplete</label>
          <help-text i18n="mixin.fieldPropsInput.autocompleteHelpText">The browser can automatically fill in fields</help-text>
          <items>
            <input name="autocomplete" type="ComboBox">
              <label i18n="mixin.fieldPropsInput.autocomplete">Autocomplete</label>
              <help-text i18n="mixin.fieldPropsInput.autocompleteHelpText">The browser can automatically fill in fields</help-text>
              <occurrences minimum="0" maximum="1"/>
              <config>
                <option value="off" i18n="mixin.fieldPropsInput.autocompleteOff">Off</option>
                <option value="on" i18n="mixin.fieldPropsInput.autocompleteOn">On</option>
                <option value="name" i18n="mixin.fieldPropsInput.autocompleteName">Name</option>
                <option value="honorific-prefix" i18n="mixin.fieldPropsInput.autocompleteHonorificPrefix">Honorific-prefix</option>
                <option value="given-name" i18n="mixin.fieldPropsInput.autocompleteGivenName">Given-name</option>
                <option value="additional-name" i18n="mixin.fieldPropsInput.autocompleteAdditionalName">Additional-name</option>
                <option value="family-name" i18n="mixin.fieldPropsInput.autocompleteFamilyName">Family-name</option>
                <option value="honorific-suffix" i18n="mixin.fieldPropsInput.autocompleteHonorificSuffix">Honorific-suffix</option>
                <option value="nickname" i18n="mixin.fieldPropsInput.autocompleteNickname">Nickname</option>
                <option value="email" i18n="mixin.fieldPropsInput.autocompleteEmail">Email</option>
                <option value="username" i18n="mixin.fieldPropsInput.autocompleteUsername">Username</option>
                <option value="organization-title" i18n="mixin.fieldPropsInput.autocompleteOrganizationTitle">Organization-title</option>
                <option value="organization" i18n="mixin.fieldPropsInput.autocompleteOrganization">Organization</option>
                <option value="street-address" i18n="mixin.fieldPropsInput.autocompleteStreetAddress">Street-address</option>
                <option value="address-level4" i18n="mixin.fieldPropsInput.autocompleteAddressLevel4">Address-level4</option>
                <option value="address-level3" i18n="mixin.fieldPropsInput.autocompleteAddressLevel3">Address-level3</option>
                <option value="address-level2" i18n="mixin.fieldPropsInput.autocompleteAddressLevel2">Address-level2</option>
                <option value="address-level1" i18n="mixin.fieldPropsInput.autocompleteAddressLevel1">Address-level1</option>
                <option value="country" i18n="mixin.fieldPropsInput.autocompleteCountry">Country</option>
                <option value="country-name" i18n="mixin.fieldPropsInput.autocompleteCountryName">Country-name</option>
                <option value="postal-code" i18n="mixin.fieldPropsInput.autocompletePostalCode">Postal-code</option>
                <option value="bday" i18n="mixin.fieldPropsInput.autocompleteBirthday">Birthday</option>
                <option value="bday-day" i18n="mixin.fieldPropsInput.autocompleteBirthdayDay">Birthday (day)</option>
                <option value="bday-month" i18n="mixin.fieldPropsInput.autocompleteBirthdayMonth">Birthday (month)</option>
                <option value="bday-year" i18n="mixin.fieldPropsInput.autocompleteBirthdayYear">Birthday (year)</option>
                <option value="sex" i18n="mixin.fieldPropsInput.autocompleteSex">Sex</option>
                <option value="tel" i18n="mixin.fieldPropsInput.autocompleteTelephone">Telephone</option>
                <option value="url" i18n="mixin.fieldPropsInput.autocompleteUrl">Url</option>
              </config>
            </input>
          </items>
        </option>

        <option name="validationRequired">
          <label i18n="mixin.fieldPropsInput.validation.required">Validation: Required</label>
          <help-text i18n="mixin.fieldPropsInput.validation.requiredHelpText">This field must always have a value</help-text>
          <items>
            <input name="errorMessage" type="TextLine">
              <label i18n="mixin.fieldPropsInput.errorMessage">Error message</label>
              <occurrences minimum="0" maximum="1"/>
            </input>
          </items>
        </option>

        <option name="validationMinLength">
          <label i18n="mixin.fieldPropsInput.validation.minLength">Validation: Minimum length</label>
          <help-text i18n="mixin.fieldPropsInput.validation.minLengthHelpText">The input in this field must have a minimum length</help-text>
          <items>
            <input name="minLength" type="Long">
              <label i18n="mixin.fieldPropsInput.minLength">Minimum length</label>
              <occurrences minimum="1" maximum="1"/>
            </input>

            <input name="errorMessage" type="TextLine">
              <label i18n="mixin.fieldPropsInput.errorMessage">Error message</label>
              <occurrences minimum="0" maximum="1"/>
            </input>
          </items>
        </option>

        <option name="validationMaxLength">
          <label i18n="mixin.fieldPropsInput.validation.maxLength">Validation: Maximum length</label>
          <help-text i18n="mixin.fieldPropsInput.validation.maxLengthHelpText">The input in this field can have a maximum length</help-text>
          <items>
            <input name="maxLength" type="Long">
              <label i18n="mixin.fieldPropsInput.maxLength">Maximum length</label>
              <occurrences minimum="1" maximum="1"/>
            </input>

            <input name="errorMessage" type="TextLine">
              <label i18n="mixin.fieldPropsInput.errorMessage">Error message</label>
              <occurrences minimum="0" maximum="1"/>
            </input>
          </items>
        </option>

        <option name="validationPattern">
          <label i18n="mixin.fieldPropsInput.validation.pattern">Validation: Pattern</label>
          <help-text i18n="mixin.fieldPropsInput.validation.patternHelpText">The input in this field must pass the specified regex</help-text>
          <items>
            <input name="regexString" type="TextLine">
              <label i18n="mixin.fieldPropsInput.regexString">Regex String</label>
              <occurrences minimum="1" maximum="1"/>
            </input>

            <input name="errorMessage" type="TextLine">
              <label i18n="mixin.fieldPropsInput.errorMessage">Error message</label>
              <occurrences minimum="0" maximum="1"/>
            </input>
          </items>
        </option>
      </options>
    </option-set>
  </form>
</mixin>
