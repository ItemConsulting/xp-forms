<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<mixin xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="mixin.options.displayName">Options</display-name>

  <description i18n="mixin.options.description">Options for radio buttons or select</description>

  <form>
    <item-set name="options">
      <label i18n="mixin.options.options">Options</label>
      <occurrences minimum="2" maximum="0"/>

      <items>
        <input name="text" type="TextLine">
          <label i18n="mixin.options.text">Text</label>
          <occurrences minimum="1" maximum="1"/>
        </input>

        <input name="value" type="TextLine">
          <label i18n="mixin.options.value">Value</label>
          <help-text i18n="mixin.options.valueHelpText">Value to submit if this alternative is chosen</help-text>
          <occurrences minimum="1" maximum="1"/>
        </input>
      </items>
    </item-set>
  </form>
</mixin>
