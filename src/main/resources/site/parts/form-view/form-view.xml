<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<part xmlns="urn:enonic:xp:model:1.0">
  <display-name i18n="part.formView.displayName">Form view</display-name>
  <description i18n="part.formView.description">Lets the user submit data</description>

  <form>
    <input name="firstPageNumber" type="RadioButton">
      <label i18n="part.formView.firstPageNumber">First page</label>
      <occurrences minimum="1" maximum="1" />
      <config>
        <option value="1" i18n="part.formView.firstPageNumber.form">Form</option>
        <option value="0" i18n="part.formView.firstPageNumber.preview">Preview</option>
      </config>
      <default>1</default>
    </input>
  </form>
</part>
