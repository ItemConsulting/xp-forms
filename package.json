{
  "name": "xp-forms",
  "version": "0.4.1",
  "homepage": "https://github.com/ItemConsulting/xp-forms",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItemConsulting/xp-forms.git"
  },
  "scripts": {
    "build": "concurrently -c auto -g --timings npm:build:*",
    "build:assets": "npx tsup -d build/resources/main/assets",
    "build:postcss": "npx postcss src/main/resources/assets/styles/*.css -m -d build/resources/main/assets --base src/main/resources/assets --ext min.css",
    "build:server": "node tsup/anyServerFiles.js && npx tsup -d build/resources/main",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "concurrently -g -r --timings npm:check:types:*",
    "check:types:assets": "npx tsc --noEmit -p src/main/resources/assets/tsconfig.json",
    "check:types:server": "node tsup/anyServerFiles.js && npx tsc --noEmit -p src/main/resources/tsconfig.json",
    "watch": "concurrently -c auto npm:watch:*",
    "watch:assets": "npm run build:assets -- --watch",
    "watch:postcss": "npm run build:postcss -- --watch",
    "watch:server": "npm run build:server -- --watch",
    "cov": "jest --no-cache --coverage",
    "lint": "biome lint src/main/resources",
    "format": "biome format --write src/main/resources",
    "test": "jest --no-cache",
    "storybook": "storybook dev -p 6006",
    "release": "npm run build",
    "versioning": "npx changeset version && npm i --package-lock-only && NEW_VERSION=$(node -p \"require('./package.json').version\") && sed -i \"s/version.*/version = ${NEW_VERSION}/\" gradle.properties"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@changesets/cli": "^2.31.0",
    "@enonic-types/core": "^7",
    "@enonic-types/global": "^7",
    "@enonic-types/lib-asset": "^1.0.3",
    "@enonic-types/lib-auth": "^7",
    "@enonic-types/lib-common": "^7",
    "@enonic-types/lib-content": "^7",
    "@enonic-types/lib-context": "^7",
    "@enonic-types/lib-event": "^7",
    "@enonic-types/lib-grid": "^7",
    "@enonic-types/lib-i18n": "^7",
    "@enonic-types/lib-mail": "^7",
    "@enonic-types/lib-node": "^7",
    "@enonic-types/lib-portal": "^7",
    "@enonic-types/lib-project": "^7",
    "@enonic-types/lib-repo": "^7",
    "@enonic/esbuild-plugin-copy-with-hash": "^0.2.0",
    "@enonic/tsup-plugin-manifest": "^0.0.1",
    "@item-enonic-types/global": "^7.15.0",
    "@item-enonic-types/lib-cloudflare-turnstile": "^0.6.0",
    "@item-enonic-types/lib-freemarker": "^3.0.0",
    "@item-enonic-types/lib-time": "^1.6.1",
    "@itemconsulting/preset-enonic-xp": "^0.5.0",
    "@itemconsulting/xp-storybook-utils": "^0.3.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.3",
    "@storybook/server-webpack5": "^10.4.6",
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "@types/cloudflare-turnstile": "^0.2.2",
    "@types/node": "^22",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10",
    "cssnano": "^8.0.2",
    "esbuild-plugin-globals": "^0.2.0",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.1",
    "postcss-nesting": "^14.0.0",
    "postcss-normalize": "^13.0.1",
    "postcss-reporter": "^7.1.0",
    "postcss-url": "^10.1.4",
    "q-i": "^2",
    "rimraf": "^6",
    "storybook": "^10.4.6",
    "ts-jest": "^29.4.11",
    "tsup": "^8",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@digdir/designsystemet-css": "^1.16.0",
    "@digdir/designsystemet-web": "^1.16.0"
  }
}
